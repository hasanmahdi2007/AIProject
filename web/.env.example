# Base URL of the Beacon gateway the console calls.
#
# Read at BUILD time, not at run time: Next.js inlines NEXT_PUBLIC_* into the
# client bundle, so changing this needs `npm run build` again, not just a
# restart. Defaults to http://localhost:8000 when unset.
#
# The console makes no other network calls. In particular it never calls the
# Anthropic API and holds no API key - every model call in Beacon happens in
# the worker, behind the gateway.
NEXT_PUBLIC_GATEWAY_URL=http://localhost:8000
