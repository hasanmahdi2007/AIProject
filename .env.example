# Beacon environment. Copy to .env and fill in. .env is gitignored and must
# never be committed.
#
# Nesting uses a double underscore: BEACON_POSTGRES__HOST sets
# settings.postgres.host. Every key below has a working default in
# beacon_core.settings except ANTHROPIC_API_KEY, so a local dev run only
# strictly needs that one.

# --- Claude -------------------------------------------------------------------
# The only required value. Named exactly as the Anthropic SDK reads it, so it
# serves both the SDK and beacon_core.settings.anthropic.api_key.
ANTHROPIC_API_KEY=

# Models, verified against platform.claude.com on 2026-11-07. Haiku for all
# development and bulk runs; Sonnet 5.5 produces the single headline number;
# Opus 5.5 is the LLM judge only, because a judge must differ from the model it
# grades.
ANTHROPIC_CHEAP_MODEL=
ANTHROPIC_HEADLINE_MODEL=
ANTHROPIC_JUDGE_MODEL=

# --- Runtime ------------------------------------------------------------------
BEACON_ENVIRONMENT=
BEACON_LOG_LEVEL=
BEACON_LOG_JSON=

# --- PostgreSQL ---------------------------------------------------------------
# Host port defaults to 15432, not 5432, because this dev machine runs a native
# PostgreSQL 18 service on 5432. deploy/compose.yaml publishes 15432 to match,
# so a normal local run needs no override here. Containers still use 5432
# internally. If 5432 is free on your machine, set both to 5432.
BEACON_POSTGRES__HOST=
BEACON_POSTGRES__PORT=
BEACON_POSTGRES__USER=
BEACON_POSTGRES__PASSWORD=
BEACON_POSTGRES__DATABASE=

# --- Redis --------------------------------------------------------------------
# Host port defaults to 16379, not 6379 - another compose project on this machine
# publishes its Redis on 6379. Same reasoning as Postgres above.
BEACON_REDIS__HOST=
BEACON_REDIS__PORT=
BEACON_REDIS__DB=
BEACON_REDIS__CONVERSATION_TTL_SECONDS=

# --- Qdrant -------------------------------------------------------------------
BEACON_QDRANT__HOST=
BEACON_QDRANT__PORT=
BEACON_QDRANT__COLLECTION=
BEACON_QDRANT__DENSE_MODEL=
BEACON_QDRANT__SPARSE_MODEL=
BEACON_QDRANT__RERANKER_MODEL=
# Leave this true. BM25 needs corpus-level IDF, and Qdrant only computes it
# when the sparse field is declared with the IDF modifier. Setting it false
# raises no error and silently degrades rare-term matching.
BEACON_QDRANT__SPARSE_IDF_MODIFIER=

# --- Kafka / Redpanda ---------------------------------------------------------
BEACON_KAFKA__BOOTSTRAP_SERVERS=
BEACON_KAFKA__CONSUMER_GROUP=
BEACON_KAFKA__MAX_RETRIES=

# --- Retrieval ----------------------------------------------------------------
BEACON_RETRIEVAL__BASE_URL=
# N generated queries. Default 3, facet-diverse. Tuned by the Day 3 sweep over
# {1, 3, 5, 10}; keep it configurable, never a literal in the prompt.
BEACON_RETRIEVAL__QUERY_COUNT=
BEACON_RETRIEVAL__FUSE_TOP_K=
BEACON_RETRIEVAL__RERANK_TOP_K=
BEACON_RETRIEVAL__RRF_K=
BEACON_RETRIEVAL__USE_RERANK=
BEACON_RETRIEVAL__APPLY_AGE_SEX_FILTERS=

# --- Data ---------------------------------------------------------------------
# The TREC corpus is large. Point this at 25 GB+ of free space OUTSIDE the repo
# so ingestion and evals share one copy. Forward slashes work on Windows.
BEACON_IR_DATASETS_HOME=
# Set this to the same path. The ir_datasets library reads its own variable,
# not Beacon's, so both have to agree.
IR_DATASETS_HOME=

# --- Observability ------------------------------------------------------------
BEACON_OTEL_ENDPOINT=
